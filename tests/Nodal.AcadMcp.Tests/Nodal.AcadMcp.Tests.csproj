<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Deliberately NOT referencing the add-in: these tests must run on any machine,
         including a CI runner with no AutoCAD installed. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Compiles run_csharp-shaped snippets in ScriptSourceTests. The version AutoCAD 2027
         ships and run_csharp uses in-process. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nodal.AcadMcp.Contracts\Nodal.AcadMcp.Contracts.csproj" />
  </ItemGroup>

</Project>
